{
  "name": "sentinel",
  "version": "0.0.0",
  "private": true,
  "description": "TaoLink v3 — Sentinel — HRIS + payroll for Commander Group of Companies.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:components:watch": "vitest --config vitest.components.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env drizzle/migrate.ts",
    "db:test:setup": "tsx --env-file-if-exists=.env scripts/db-test-setup.ts",
    "db:seed-compliance": "tsx --env-file-if-exists=.env scripts/seed-compliance.ts",
    "db:seed:slice2-demo": "tsx --env-file-if-exists=.env db/seeds/slice2-demo.ts",
    "db:studio": "drizzle-kit studio",
    "db:backfill:persons": "tsx --env-file-if-exists=.env db/backfills/0021-persons.ts",
    "db:stress": "tsx --env-file-if-exists=.env db/stress/run.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@react-pdf/renderer": "^4.5.1",
    "downshift": "^9.3.3",
    "drizzle-orm": "^0.36.4",
    "next": "^15.0.4",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.0.0"
  }
}
